{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "@runnerty-executor-ftp",
  "definitions": {
    "config": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "pattern": "@runnerty-executor-ftp"
        },
        "protocol": {
          "type": "string",
          "enum": ["sftp"],
          "default": "sftp"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": ["number", "string"]
        },
        "user": {
          "type": "string",
          "description": "Alias de username, se normaliza internamente"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "privateKey": {
          "type": "string"
        },
        "privateKeyPath": {
          "type": "string",
          "description": "Ruta a la clave privada en formato PEM"
        },
        "passphrase": {
          "type": "string"
        },
        "readyTimeout": {
          "type": "number"
        }
      }
    },
    "params": {
      "type": "object",
      "required": ["id", "command"],
      "properties": {
        "id": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "regexp": { "pattern": "^(GET|PUT|LIST|MKDIR|RMDIR|DELETE|RENAME|CHMOD)$", "flags": "i" }
        },
        "remotePath": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "destinationPath": {
          "type": "string"
        },
        "recursive": {
          "type": "boolean"
        },
        "mode": {
          "type": ["string", "number"],
          "description": "Modo para chmod (por ejemplo, 0o644 o '644')"
        },
        "addtionalOptions": {
          "type": ["object", "boolean"],
          "description": "Opciones adicionales (mantiene nombre legado)"
        }
      }
    }
  }
}
